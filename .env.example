# Copy this file to .env and fill in your values.

# SQLite (default) – change to PostgreSQL for production:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/corruporg
DATABASE_URL=sqlite:///./corrup.db

# Optional: Portal da Transparência API key
# Obtain at https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# Override Portal da Transparência base URL (leave blank to use the default)
# TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados

DEBUG=false
